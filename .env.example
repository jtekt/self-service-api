# PostgREST image
PGRST_IMAGE=postgrest/postgrest

# Optional OIDC configuration
PGRST_JWT_CERT_URL=
PGRST_JWT_CLAIM_KEY=email

# Default database values shown in UI
DEFAULT_HOST=postgres
DEFAULT_PORT=5432
DEFAULT_READ_ONLY=false

# Prefix for deployed resources
DATABASE_NAME_PREFIX=self-service-api

# Kubernetes namespace
K8S_NAMESPACE=default

# ---- Exposure of deployed APIs ----
# Service type: ClusterIP (default), NodePort or LoadBalancer
SERVICE_TYPE=
# JSON object of annotations to add to the Service (e.g. cloud LB config)
SERVICE_ANNOTATIONS=

# URL shown to users. {name} is the API's name; {nodePort} its Service's
# node port (SERVICE_TYPE=NodePort only). Ingress and HTTPRoute hostnames
# come from it. Unset: no URL shown
API_URL_TEMPLATE=https://{name}.example.com
# NodePort example: API_URL_TEMPLATE=http://10.0.0.5:{nodePort}

# Ingress: created only if INGRESS_CLASS_NAME is set (e.g. nginx, traefik)
INGRESS_CLASS_NAME=
# JSON object of annotations to add to the Ingress (e.g. cert-manager)
INGRESS_ANNOTATIONS=
# Enables TLS on the Ingress using this pre-existing secret (e.g. a wildcard cert)
INGRESS_TLS_SECRET_NAME=

# HTTPRoute (Gateway API): created only if set. JSON array of parentRefs
HTTPROUTE_PARENT_REFS=
# e.g. HTTPROUTE_PARENT_REFS=[{"name":"eg","namespace":"envoy-gateway-system"}]

# Optional help link
HELP_URL=
